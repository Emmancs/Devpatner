# ==========================================
# DevPilot AI - Environment Configuration
# ==========================================

# Environment
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devpilot?schema=public"

# Backend Server
PORT=3001
API_PREFIX="api/v1"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# Authentication & Security
# Generate with: openssl rand -base64 32
JWT_SECRET="devpilot_jwt_secret_change_in_production_min_32_chars!"
JWT_EXPIRES_IN="7d"
SESSION_COOKIE_NAME="devpilot_session"
# 32-byte encryption key (64 hex characters) for token encryption at rest
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# GitHub Integration (OAuth / GitHub App)
# Create a GitHub App or OAuth App under Developer Settings
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_APP_ID=""
GITHUB_CALLBACK_URL="http://localhost:3001/api/v1/auth/github/callback"

# AI Provider Configuration (Google Gemini / OpenAI compatible)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_TOKENS_PER_REQUEST=8192

# Analysis Limits & Guardrails
MAX_REPO_SIZE_MB=50
MAX_FILE_SIZE_KB=500
MAX_FILES_PER_ANALYSIS=250
MAX_CONCURRENT_ANALYSIS_JOBS=3

# Frontend Public Variables
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_NAME="DevPilot AI"

