{
  "name": "devpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "DevPilot AI - Production-grade AI Software Engineering Assistant",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=@devpilot/api run start:dev",
    "dev:web": "npm --workspace=@devpilot/web run dev",
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}

